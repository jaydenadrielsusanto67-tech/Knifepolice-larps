-- Instant listener for new objects
keep(game.DescendantAdded:Connect(function(obj)
	if env[KEY] ~= state then return end
	applyTexture(obj)
	patchSound(obj)

	if obj:IsA("MeshPart") or obj:IsA("Texture") or obj:IsA("Decal") then
		obj:GetPropertyChangedSignal(obj:IsA("MeshPart") and "TextureID" or "Texture"):Connect(function()
			if env[KEY] == state then applyTexture(obj) end
		end)
	end
end))

